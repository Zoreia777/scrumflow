# ScrumFlow — configuração local.
# Copie este arquivo para ".env" (mesma pasta) e NÃO versione o ".env".
# Usado pelo Docker Compose (banco) e pelo backend. O valor de POSTGRES_PASSWORD
# é apenas um marcador para uso local: troque se o banco for exposto fora da sua máquina.

POSTGRES_USER=scrumflow
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=scrumflow
POSTGRES_TEST_DB=scrumflow_test
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Origens autorizadas a chamar a API (separadas por vírgula).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
